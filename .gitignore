# This .gitignore is targeted towards Unity projects

# Autogenerated Folders #
##########################
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS / editor cruft
.DS_Store
Thumbs.db
.vs/
.idea/
.utmp/

# MCP for Unity local session state (per-machine, not shared)
/[Aa]ssets/XR/Settings/*.local.asset

# Imported asset packs are ignored by default. Dependencies of active ViCSI scenes
# are tracked explicitly so a checkpoint can restore the scene without broken GUIDs.
/Assets/ScifiOfficeLite/
/Assets/ScifiOfficeLite.meta
/Assets/(HDRP) NYC-Like City Buildings Set (PBR)/
/Assets/(HDRP) NYC-Like City Buildings Set (PBR).meta
/Assets/Barking_Dog/
/Assets/Barking_Dog.meta
/Assets/Samples/
/Assets/Samples.meta
/Assets/Screenshots/
/Assets/Screenshots.meta
/Assets/Unity UI Samples/
/Assets/Unity UI Samples.meta

# Unity autosave/crash-recovery scratch data and default template boilerplate
/Assets/_Recovery/
/Assets/_Recovery.meta
/Assets/TutorialInfo/
/Assets/TutorialInfo.meta

# Standalone .NET tooling under Tools/ (EvidenceScorer). Unity never compiles these,
# and their build output must not enter the repo.
Tools/**/bin/
Tools/**/obj/

# ...but Tools/ .csproj files are hand-written, not Unity-generated, and are the only
# way the standalone scorer builds. Un-ignore them explicitly (line 23's *.csproj is
# there for Unity's regenerated project files).
!Tools/**/*.csproj

# Local credentials for future API/dashboard development; templates stay reviewable.
.env
.env.*
!.env.example
!.env.*.example

# Per-machine credentials and Meta diagnostic session state.
/Assets/Resources/DevAgentSettings.asset
/Assets/Resources/DevAgentSettings.asset.meta
/Assets/#Meta/
/Assets/#Meta.meta
vicsi_vr_device_sync_key.txt
vicsi_vr_device_sync_key.txt.meta
VR_DEVICE_SYNC_KEY
VR_DEVICE_SYNC_KEY.meta
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key

# Generated editor schemas, solution files, crash reports and inspection scratch.
/UIElementsSchema/
*.slnx
/hs_err_pid*.log
/pdf_check.txt

# Local Phase 5 reports and one-off copies of the separate backend repository.
/docs/evidence/phase5-last-drink/
/Tools/Phase5BackendStage/
/Tools/Audit/prepare-last-drink-backend.mjs
/Tools/Audit/prepare-last-drink-content.mjs
/Tools/phase5-editor-state.json
/Tools/phase5-instances.json
/Tools/phase5-telemetry.json

# Local validation logs and scene backup copies; keep reports and screenshots.
/docs/evidence/**/*.log
/docs/evidence/**/*.unity
/docs/evidence/**/*.unity.meta
/docs/evidence/**/*.before

# Validation screenshots are retained in the complete local research archive.
/docs/evidence/**/*.png
/docs/evidence/**/*.png.meta

# Headset captures and raw device logs stay local; retain concise validation reports.
/docs/evidence/competitive-headset-2026-10-23/*-logcat.txt
/docs/evidence/competitive-headset-2026-10-23/device-logs/

# Verified downloadable Asset Store binaries; exact versions/GUIDs are in docs/ASSET_STORE_DEPENDENCIES.json.
