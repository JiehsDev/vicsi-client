  checkpoints:
  - id: HYP-01
    promptText: "What do you think you can reasonably say about the case so far?"
    options:
    - id: theory-accidental-fall
      text: Peter is responsible because the vendor saw him leave.
    - id: theory-homicide
      text: Paul is responsible because he argued with John earlier.
    - id: theory-undetermined
      text: John was attacked, but there is not enough reliable evidence yet to identify
        the attacker.
    - id: theory-alcohol-explanation
      text: The drinking explains what happened to John.
    requiresReasoning: 1
    reasoningOptions:
    - id: hyp01-peter-departure-proves-guilt
      text: Peter's later departure and uneasy appearance establish that he attacked John.
      isCorrect: 0
      prerequisites: []
