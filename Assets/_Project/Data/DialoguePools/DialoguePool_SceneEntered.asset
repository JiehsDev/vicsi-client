  m_Script: {fileID: 11500000, guid: 7c090a6e689265a4dafbefd331d324c5, type: 3}
  m_Name: DialoguePool_SceneEntered
  m_EditorClassIdentifier: Assembly-CSharp::DialogueLinePool
  lines:
  - 'First Responder: Got the call at 11:42 - first on scene, nobody''s touched anything
    since I arrived.'
  - 'First Responder: Perimeter''s secured, one way in, one way out. Just me until
    your team got here.'
  - "First Responder: Found him on the kitchen floor. Stab wound's visible \u2014
    this isn't an accident. That's why you're here."
  - 'First Responder: Log''s started. Chain of custody''s yours from this point.'
