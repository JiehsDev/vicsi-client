  m_Name: EVD-014_KitchenKnife
  m_EditorClassIdentifier: Assembly-CSharp::EvidenceDefinition
  evidenceId: EVD-014
  displayName: Kitchen knife
  relevance: 0
  interactionRadius: 1.5
  requiresFingerprinting: 1
  fingerprintBeforeCollection: 1
  requiresFlipBeforeFingerprinting: 0
  fingerprintMatchIdentity: Paul
  description: A household kitchen knife with a blade measuring approximately 15
    centimetres.
  foundLocation: On the kitchen floor, approximately 1.2 metres from the victim.
  observedCondition: The knife was lying exposed. Reddish residue was visible along
    the blade edge; the handle was retained for latent-print processing.
  investigativeContext: Blade dimensions, biological material and handling traces
    can be compared with other documented evidence. These observations support the
    knife as a possible weapon, but do not establish who used it during the attack.
  loggingContext: 
  progressiveFindings:
  - text: A sample was collected from the reddish residue along the blade edge.
    revealRequirement:
      kind: 0
      operatorType: 0
      children: []
