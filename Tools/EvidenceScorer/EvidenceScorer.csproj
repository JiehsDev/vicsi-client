<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately OUTSIDE Assets/ so Unity never tries to compile it. This tool
       reads exported artifacts after the fact and shares no code with the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VicsiScoring</RootNamespace>
    <AssemblyName>EvidenceScorer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
